# Upstream Termux Firefox version — watched by Renovate (config: /renovate.json).
#
# Role: detection ledger + guarded auto-merge approval surface. When the live
# Termux recipe moves, Renovate opens a same-repository PR updating only the
# value below. The workflow_run gate validates exact repository Actions-bot
# identity, same-repo provenance, single-file/single-bump diff shape, the
# commit-pinned live recipe, forward ordering, the N.1 invariant, and head-SHA
# atomicity. Qualified bumps merge automatically; every decline is labeled
# needs-human for an exception-only maintainer decision.
#
# The build itself still reads the live commit-pinned Termux recipe; this file
# is a detection/approval anchor, not build input.
termuxFirefoxVersion = "157.0.1"
