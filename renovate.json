{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "onboarding": false,
  "requireConfig": "ignored",
  "autodiscover": false,
  "enabledManagers": ["custom.regex"],
  "dependencyDashboard": false,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^port/upstream\\.renovate$"],
      "matchStrings": [
        "termuxFirefoxVersion\\s*=\\s*\"(?<currentValue>[0-9][0-9.]*)\""
      ],
      "depNameTemplate": "termux-firefox-upstream",
      "datasourceTemplate": "custom.termux-firefox",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?$"
    }
  ],
  "customDatasources": {
    "termux-firefox": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/termux/termux-packages/master/x11-packages/firefox/build.sh",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [ {\"version\": $match($filter($append([], $), function($l){ $contains($l, \"TERMUX_PKG_VERSION=\") })[0], /TERMUX_PKG_VERSION=\"([0-9][0-9.]*)\"/).groups[0]} ] }"
      ]
    }
  },
  "packageRules": [
    {
      "matchDepNames": ["termux-firefox-upstream"],
      "enabled": true,
      "labels": ["upstream", "renovate"],
      "commitMessageTopic": "Termux upstream Firefox"
    }
  ]
}
