{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "onboarding": false,
  "requireConfig": "ignored",
  "autodiscover": false,
  "enabledManagers": ["custom.regex"],
  "dependencyDashboard": false,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^port/upstream\\.renovate$"],
      "matchStrings": [
        "termuxFirefoxVersion\\s*=\\s*\"(?<currentValue>[0-9][0-9.]*)\""
      ],
      "datasourceTemplate": "customText",
      "depNameTemplate": "termux-firefox-upstream",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?$"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["termux-firefox-upstream"],
      "registryUrls": [
        "https://raw.githubusercontent.com/termux/termux-packages/master/x11-packages/firefox/build.sh"
      ],
      "matchStrings": [
        "TERMUX_PKG_VERSION=\"(?<currentValue>[0-9][0-9.]*)\""
      ],
      "enabled": true,
      "labels": ["upstream", "renovate"],
      "commitMessageTopic": "Termux upstream Firefox"
    }
  ]
}
